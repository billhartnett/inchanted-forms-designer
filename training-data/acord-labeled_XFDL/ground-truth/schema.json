{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inchanted.com/schemas/xfdl-ground-truth.v1.json",
  "title": "XFDL form ground truth",
  "type": "object",
  "required": [
    "schemaVersion",
    "source",
    "form",
    "pages",
    "fields",
    "labels",
    "tables",
    "groups",
    "dataModel",
    "suppression",
    "statistics",
    "provenance",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": { "const": "xfdl-ground-truth.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "required": ["fileName", "relativePath", "bytes", "sha256", "encoding"],
      "properties": {
        "fileName": { "type": "string" },
        "relativePath": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "encoding": { "type": "string" }
      }
    },
    "form": { "type": "object" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sid", "index", "number"],
        "properties": {
          "sid": { "type": "string" },
          "index": { "type": "integer", "minimum": 0 },
          "number": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sid", "tag", "role", "pageIndex", "geometry", "fieldType", "semantic", "behavior", "suppression"],
        "properties": {
          "sid": { "type": "string", "minLength": 1 },
          "tag": { "enum": ["field", "check"] },
          "role": { "const": "fillable-field" },
          "pageIndex": { "type": "integer", "minimum": 0 },
          "fieldType": { "enum": ["text", "checkbox", "date", "numeric", "dropdown", "signature"] },
          "geometry": { "$ref": "#/$defs/geometry" },
          "semantic": { "type": "object" },
          "behavior": { "type": "object" },
          "suppression": { "type": "object" },
          "tableCell": { "type": ["object", "null"] }
        }
      }
    },
    "labels": { "type": "array" },
    "tables": { "type": "array" },
    "groups": { "type": "array" },
    "dataModel": { "type": "object" },
    "suppression": { "type": "object" },
    "statistics": { "type": "object" },
    "provenance": { "type": "object" },
    "diagnostics": { "type": "array" }
  },
  "$defs": {
    "geometry": {
      "type": "object",
      "required": ["x", "y", "width", "height", "coordinateSystem", "provenance"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "page": { "type": ["number", "null"] },
        "within": { "type": ["string", "null"] },
        "coordinateSystem": { "const": "xfdl-layout-units" },
        "provenance": { "const": "explicit" }
      }
    }
  }
}
