    <button sid="Email_BUTTON">
      <pecs:short_cut xfdl:compute="toggle(global.global.keypress, '', 'F3') == '1' ? (set('activated','on')) : ''"></pecs:short_cut>
      <type>submit</type>
      <bgcolor>
        <ae>190</ae>
        <ae>0</ae>
        <ae>76</ae>
      </bgcolor>
      <justify>center</justify>
      <fontcolor>
        <ae compute="mouseover == 'on' ? 'yellow' : 'white'">white</ae>
      </fontcolor>
      <fontinfo>
        <ae>Helvetica</ae>
        <ae>7</ae>
        <ae>bold</ae>
      </fontinfo>
      <value>Email</value>
      <url>
        <ae compute="'mailto:?filename=' +. global.global.custom:attachment_filename">mailto:?filename=ACORDForm.xfdl</ae>
      </url>
      <custom:on_activated xfdl:compute="&#xA;&#xA;&#xA;(toggle(activated, 'off', 'on') == '1') &#xA;&#xA;&#xA;? ((viewer.getDefaultFilename() != '') &#xA;&#xA;&#xA;? set('global.global.custom:attachment_filename', viewer.getDefaultFilename()) &#xA;&#xA;&#xA;: '' &#xA;&#xA;&#xA;) &#xA;&#xA;&#xA;: ''"></custom:on_activated>
      <borderwidth>0</borderwidth>
      <visible>on</visible>
      <itemlocation>
        <ae>
          <ae>within</ae>
          <ae>TOOLBAR</ae>
        </ae>
        <ae>
