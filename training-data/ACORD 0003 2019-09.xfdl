      <previous>Save_BUTTON</previous>
      <next>Fax_BUTTON</next>
    </button>
    <button sid="Fax_BUTTON">
      <pecs:short_cut xfdl:compute="toggle(global.global.keypress, '', 'F4') == '1' ? (set('activated','on')) : ''"></pecs:short_cut>
