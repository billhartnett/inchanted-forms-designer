      <borderwidth>0</borderwidth>
      <visible>on</visible>
      <itemlocation>
        <ae>
          <ae>within</ae>
          <ae>TOOLBAR</ae>
        </ae>
        <ae>
          <ae>absolute</ae>
          <ae>305</ae>
