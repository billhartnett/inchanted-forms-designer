    </button>
    <button sid="Print_BUTTON">
      <pecs:short_cut xfdl:compute="toggle(global.global.keypress, '', 'F3') == '1' ? (set('activated','on')) : ''"></pecs:short_cut>
      <type>print</type>
      <bgcolor>
        <ae>190</ae>
        <ae>0</ae>
        <ae>76</ae>
      </bgcolor>
      <justify>center</justify>
      <fontcolor>
        <ae compute="mouseover == 'on' ? 'yellow' : 'white'">white</ae>
      </fontcolor>
      <fontinfo>
        <ae>Helvetica</ae>
        <ae>7</ae>
        <ae>bold</ae>
      </fontinfo>
      <value>PDF</value>
      <borderwidth>0</borderwidth>
      <visible>on</visible>
      <itemlocation>
        <ae>
          <ae>within</ae>
          <ae>TOOLBAR</ae>
        </ae>
        <ae>
          <ae>absolute</ae>
          <ae>305</ae>
          <ae>45</ae>
        </ae>
        <ae>
          <ae>extent</ae>
          <ae>45</ae>
