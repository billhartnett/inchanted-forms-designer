      </itemLocation>
      <value>False</value>
      <next>Policy_Payment_RemarkText_A</next>
      <help>HelpPolicy_Payment_OtherIndicator_A</help>
    </check>
    <help sid="HelpPolicy_Payment_OtherIndicator_A">
      <value>Check the box (if applicable): Indicates the policy will be paid in a frequency other than those listed.</value>
    </help>
