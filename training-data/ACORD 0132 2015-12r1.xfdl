        </ae>
      </itemlocation>
      <previous>global</previous>
      <next>Print_BUTTON</next>
    </button>
    <button sid="Print_BUTTON">
      <pecs:short_cut xfdl:compute="toggle(global.global.keypress, '', 'F3') == '1' ? (set('activated','on')) : ''"></pecs:short_cut>
      <type>print</type>
      <bgcolor>
        <ae>190</ae>
        <ae>0</ae>
        <ae>76</ae>
      </bgcolor>
      <justify>center</justify>
      <fontcolor>
        <ae compute="mouseover == 'on' ? 'yellow' : 'white'">white</ae>
      </fontcolor>
      <fontinfo>
        <ae>Helvetica</ae>
        <ae>7</ae>
        <ae>bold</ae>
      </fontinfo>
      <value>PDF</value>
      <borderwidth>0</borderwidth>
      <visible>on</visible>
      <itemlocation>
        <ae>
          <ae>within</ae>
          <ae>TOOLBAR</ae>
        </ae>
        <ae>
          <ae>absolute</ae>
          <ae>305</ae>
          <ae>45</ae>
        </ae>
        <ae>
          <ae>extent</ae>
          <ae>45</ae>
          <ae>21</ae>
        </ae>
      </itemlocation>
      <pecs:on_click xfdl:compute="toggle(activated,'off','on')=='1'?viewer.messageBox('Please ensure PDF printer driver is installed then select it from the following Print dialog.','PDF','OK'):''"></pecs:on_click>
      <previous>Save_BUTTON</previous>
      <next>Fax_BUTTON</next>
    </button>
    <button sid="Fax_BUTTON">
      <pecs:short_cut xfdl:compute="toggle(global.global.keypress, '', 'F4') == '1' ? (set('activated','on')) : ''"></pecs:short_cut>
      <type>print</type>
      <bgcolor>
        <ae>190</ae>
        <ae>0</ae>
        <ae>76</ae>
      </bgcolor>
      <justify>center</justify>
      <fontcolor>
        <ae compute="mouseover == 'on' ? 'yellow' : 'white'">white</ae>
      </fontcolor>
      <fontinfo>
        <ae>Helvetica</ae>
        <ae>7</ae>
        <ae>bold</ae>
      </fontinfo>
      <pecs:on_click xfdl:compute="toggle(activated, 'off', 'on') == '1' ? viewer.messageBox('Please ensure fax software is first installed then select Fax from the following Print dialog.','Fax','OK') : ''"></pecs:on_click>
      <value>Fax</value>
