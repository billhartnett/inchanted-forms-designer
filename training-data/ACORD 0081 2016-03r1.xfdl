      <fontcolor>
        <ae compute="mouseover == 'on' ? 'yellow' : 'white'">yellow</ae>
      </fontcolor>
      <fontinfo>
        <ae>Helvetica</ae>
        <ae>7</ae>
        <ae>bold</ae>
      </fontinfo>
