    <button sid="feedback_BUTTON">
      <type>submit</type>
      <pecs:short_cut xfdl:compute="toggle(global.global.keypress, '', 'F7') == '1' ? (set('activated','on')) : ''"></pecs:short_cut>
      <bgcolor>
