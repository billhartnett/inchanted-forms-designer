        </ae>
        <ae>
          <ae>extent</ae>
          <ae>940</ae>
          <ae>24</ae>
        </ae>
      </itemlocation>
    </label>
    <label sid="J_">
      <value>penalties.  Should aggravating circumstances [be] present, the penalty thus established may be increased to a maximum of five (5) years, if</value>
      <fontinfo>
        <ae>Arial</ae>
        <ae>9</ae>
        <ae>plain</ae>
      </fontinfo>
      <justify>left</justify>
