        <ae>upper_case</ae>
        <ae>optional</ae>
        <template>
          <ae>@</ae>
        </template>
      </format>
    </field>
    <help sid="HelpLossHistory_PriorLossesCode_A">
      <value>Enter Y for a &#x201C;Yes&#x201D; response. Input N for &#x201C;No&#x201D; response. Indicates if there have been any losses at any location, whether paid or not paid by insurance, in the last mandated number of years. As used here, indicates if there has been an auto accident or liability loss on a primary or excess policy, regardless of fault.</value>
