        <ae>
          <ae>offset</ae>
          <ae>-10</ae>
          <ae>0</ae>
        </ae>
      </itemlocation>
    </label>
    <label sid="G_">
      <value>presents, helps, or causes the presentation of a fraudulent claim for the payment of a loss or any other benefit, or presents more than one</value>
      <fontinfo>
        <ae>Arial</ae>
        <ae>9</ae>
        <ae>plain</ae>
      </fontinfo>
      <justify>left</justify>
      <itemlocation>
