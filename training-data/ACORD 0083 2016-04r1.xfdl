    <label sid="F_">
      <value>Any person who knowingly and with the intention of defrauding presents false information in an insurance application, or</value>
      <fontinfo>
        <ae>Arial</ae>
        <ae>9</ae>
        <ae>plain</ae>
      </fontinfo>
      <justify>left</justify>
      <itemlocation>
