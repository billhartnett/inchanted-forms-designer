      <previous>Save_BUTTON</previous>
      <next>Fax_BUTTON</next>
    </button>
    <button sid="Fax_BUTTON">
      <pecs:short_cut xfdl:compute="toggle(global.global.keypress, '', 'F4') == '1' ? (set('activated','on')) : ''"></pecs:short_cut>
      <type>print</type>
      <bgcolor>
        <ae>190</ae>
        <ae>0</ae>
        <ae>76</ae>
      </bgcolor>
      <justify>center</justify>
      <fontcolor>
        <ae compute="mouseover == 'on' ? 'yellow' : 'white'">white</ae>
      </fontcolor>
      <fontinfo>
        <ae>Helvetica</ae>
        <ae>7</ae>
        <ae>bold</ae>
      </fontinfo>
      <pecs:on_click xfdl:compute="toggle(activated, 'off', 'on') == '1' ? viewer.messageBox('Please ensure fax software is first installed then select Fax from the following Print dialog.','Fax','OK') : ''"></pecs:on_click>
      <value>Fax</value>
