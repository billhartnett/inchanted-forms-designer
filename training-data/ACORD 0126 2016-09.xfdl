    <button sid="feedback_BUTTON">
      <type>submit</type>
      <pecs:short_cut xfdl:compute="toggle(global.global.keypress, '', 'F7') == '1' ? (set('activated','on')) : ''"></pecs:short_cut>
      <bgcolor>
        <ae>190</ae>
        <ae>0</ae>
        <ae>76</ae>
      </bgcolor>
      <justify>center</justify>
      <fontcolor>
        <ae compute="mouseover == 'on' ? 'yellow' : 'white'">white</ae>
