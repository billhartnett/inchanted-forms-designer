        </ae>
      </itemlocation>
      <previous>global</previous>
      <next>Print_BUTTON</next>
    </button>
    <button sid="Print_BUTTON">
      <pecs:short_cut xfdl:compute="toggle(global.global.keypress, '', 'F3') == '1' ? (set('activated','on')) : ''"></pecs:short_cut>
      <type>print</type>
      <bgcolor>
        <ae>190</ae>
        <ae>0</ae>
        <ae>76</ae>
      </bgcolor>
      <justify>center</justify>
      <fontcolor>
        <ae compute="mouseover == 'on' ? 'yellow' : 'white'">white</ae>
      </fontcolor>
      <fontinfo>
        <ae>Helvetica</ae>
        <ae>7</ae>
        <ae>bold</ae>
      </fontinfo>
