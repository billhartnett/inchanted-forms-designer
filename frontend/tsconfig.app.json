{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["../shared/src/*"],
      "@shared/acord/*": ["../shared/src/acord/*"],
      "@shared/acord": ["../shared/src/acord/index.ts"],
      "@shared/quality": ["../shared/src/quality/index.ts"],
      "@shared/types": ["../shared/src/types/index.ts"],
      "@shared/extraction": ["../shared/src/extraction/index.ts"]
    },

    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "strict": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "allowJs": false,
    "isolatedModules": true
  },
  "include": ["src"]
}
