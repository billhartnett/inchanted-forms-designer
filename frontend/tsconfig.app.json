{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["../shared/dist/*"],
      "@shared/acord/*": ["../shared/dist/acord/*"],
      "@shared/acord": ["../shared/dist/acord/index.js"],
      "@shared/quality": ["../shared/dist/quality/index.js"],
      "@shared/types": ["../shared/dist/types/index.js"]
    },

    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "strict": true,
    "skipLibCheck": true,
    "allowJs": false,
    "isolatedModules": true
  },
  "include": ["src"]
}
